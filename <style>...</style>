```html
<style>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
    background: #eef1f5;
    transition: 0.3s;
  }

  body.dark {
    background: #111827;
  }

  .calculator {
    width: min(420px, 100%);
    padding: clamp(16px, 4vw, 24px);
    border-radius: 25px;
    background: white;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
  }

  body.dark .calculator {
    background: #1f2937;
    color: white;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  h1 {
    font-size: clamp(20px, 5vw, 24px);
    margin: 0 0 15px;
  }

  .theme {
    border: none;
    background: none;
    font-size: 22px;
    cursor: pointer;
    flex-shrink: 0;
  }

  #display {
    width: 100%;
    height: clamp(65px, 15vw, 80px);
    border: none;
    border-radius: 15px;
    background: #f3f4f6;
    text-align: right;
    padding: 12px;
    font-size: clamp(26px, 8vw, 36px);
    margin-bottom: 15px;
    outline: none;
    min-width: 0;
  }

  body.dark #display {
    background: #111827;
    color: white;
  }

  .buttons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(7px, 2vw, 10px);
  }

  button {
    width: 100%;
    height: clamp(52px, 13vw, 62px);
    border: none;
    border-radius: 15px;
    font-size: clamp(18px, 5vw, 21px);
    cursor: pointer;
    background: #e5e7eb;
    transition: transform 0.1s, filter 0.1s;
    -webkit-tap-highlight-color: transparent;
  }

  button:active {
    transform: scale(0.94);
  }

  button:hover {
    filter: brightness(0.97);
  }

  .operator {
    background: #dbeafe;
  }

  .equal {
    background: #2563eb;
    color: white;
  }

  .clear {
    background: #fee2e2;
  }

  .history {
    margin-top: 20px;
    max-height: 150px;
    overflow-y: auto;
  }

  .history h3 {
    margin-bottom: 8px;
  }

  .history-item {
    padding: 8px;
    border-bottom: 1px solid #ddd;
    font-size: 14px;
    overflow-wrap: anywhere;
  }

  .clear-history {
    width: 100%;
    height: 42px;
    margin-top: 8px;
    font-size: 14px;
  }

  /* Small phones */
  @media (max-width: 380px) {
    body {
      padding: 10px;
    }

    .calculator {
      padding: 14px;
      border-radius: 20px;
    }

    .buttons {
      gap: 6px;
    }

    button {
      border-radius: 12px;
    }
  }

  /* Landscape phones */
  @media (max-height: 550px) and (orientation: landscape) {
    body {
      align-items: flex-start;
      padding: 10px;
    }

    .calculator {
      margin: auto;
    }

    #display {
      height: 60px;
      margin-bottom: 10px;
    }

    button {
      height: 45px;
    }

    .history {
      max-height: 80px;
      margin-top: 12px;
    }
  }

  /* Tablets */
  @media (min-width: 600px) {
    .calculator {
      width: 440px;
    }

    button {
      height: 64px;
    }
  }
</style>
